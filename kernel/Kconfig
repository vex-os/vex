source "kernel/arch/$(ARCH)/Kconfig"

# Capabilities, selected by architecture code

config ARCH_HAS_SMP
    bool

config ARCH_HAS_DEBUGCON
    bool

menu "Processes and scheduling"
source "kernel/proc/Kconfig"
endmenu

menu "Console and logging"
source "kernel/core/Kconfig"
endmenu

menu "Block devices"
source "kernel/dev/Kconfig"
endmenu

menu "Device drivers"
source "kernel/drivers/Kconfig"
endmenu

menu "Filesystems"
source "kernel/fs/Kconfig"
endmenu

menu "Debugging"

config KASSERT
    bool "Kernel assertions"
    default y
    help
      Check kassert() conditions at runtime and panic
      with the failed expression when one does not hold

comment "Tracing"

config TRACE_BLK_EVENTS
    bool "Trace block device events"
    help
      Log block devices being added and removed;
      shown only with loglevel=verbose

config TRACE_CHR_EVENTS
    bool "Trace character device events"
    help
      Log character devices being added and removed;
      shown only with loglevel=verbose

config TRACE_INITCALLS
    bool "Trace initcalls"
    help
      Log every initcall before it runs, which helps to find
      the one a boot hangs in; shown only with loglevel=verbose

endmenu
