menu "Filesystems"

config VCACHE_MAX_UNUSED
    int "Unused vnodes kept cached"
    range 0 1048576
    default 1024
    help
      Vnodes that nobody holds stay cached up to this many,
      so looking the same paths up again needs no disk access

config FCACHE_WRITEBACK_MSEC
    int "File cache writeback interval (ms)"
    range 100 600000
    default 5000
    help
      How often dirty file pages and filesystem
      metadata are written back to disk

config FCACHE_DIRTY_PERCENT
    int "Dirty file cache limit (percent of memory)"
    range 1 90
    default 20
    help
      A write that finds more of memory dirty than this
      writes its own file back before returning

choice
    prompt "Access time updates on read"
    default ATIME_RELATIME
    help
      Whether reading a file or a directory moves its
      access time, which costs an inode write when it does

config ATIME_RELATIME
    bool "relatime"
    help
      Only when the access time is not past the last change,
      or is older than ATIME_RELATIME_INTERVAL; as in Linux

config ATIME_STRICT
    bool "strictatime"
    help
      On every read, as POSIX asks

config ATIME_NONE
    bool "noatime"
    help
      Never; only utimensat and file creation set it

endchoice

config ATIME_RELATIME_INTERVAL
    int "Relatime update interval (seconds)"
    depends on ATIME_RELATIME
    range 1 31536000
    default 86400
    help
      An access time this much older than now is moved
      even when the file has not changed since

config DEVFS
    bool "Device filesystem"
    default y

config ECHFS
    bool "echfs"
    default y

config EXT2
    bool "ext2"
    default y

config FAT
    bool "FAT"
    default y

endmenu
