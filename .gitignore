## Ignore some files generated by VSCode
## except some things we might actually need
/.vscode/
/.vscode/*
!/.vscode/c_cpp_properties.json
!/.vscode/launch.json

## Ignore build and output directories with
## everything build process generates
/build/
/build/*
/output/
/output/*

## Ignore stuff python runtime generates
__pycache__/
__pycache__/*
*.pyc

## Ignore configuration artifacts
.configuration.mk
